{
  "headers": [
    {
      "source": "/newsroom/(.*).(png|jpg)",
      "headers": [
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/price-alerts/check",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cache-warm",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/market-movers",
      "schedule": "0 14,18 * * 1-5"
    },
    {
      "path": "/api/cron/market-news",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/daily-recap",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/watchlist-news",
      "schedule": "45 13,15,17,19,21 * * 1-5"
    },
    {
      "path": "/api/newsroom/auto?slot=open",
      "schedule": "45 14 * * 1-5"
    },
    {
      "path": "/api/newsroom/auto?slot=midday",
      "schedule": "45 17 * * 1-5"
    },
    {
      "path": "/api/newsroom/auto?slot=close",
      "schedule": "15 21 * * 1-5"
    }
  ]
}
